# Endereço da API, visto pelo navegador. É lido na hora do build.
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# Endereço da API visto pelo servidor da Web, que confere a sessão antes de cada página.
# Sem ele, vale o NEXT_PUBLIC_API_URL. No Docker é http://api:3333/api (o nome do serviço).
# API_URL_INTERNA=http://localhost:3333/api
