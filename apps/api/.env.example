# Copie para .env (cp .env.example .env) antes de rodar a API fora do Docker.
NODE_ENV=development
PORT=3333
DATABASE_PATH=./academia.sqlite

# Obrigatório: no mínimo 32 caracteres. Troque por um valor próprio em qualquer ambiente real.
JWT_SECRET=troque-este-segredo-por-um-valor-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=28800

# Origem do front-end, liberada no CORS.
CORS_ORIGIN=http://localhost:3000
