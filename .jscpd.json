{
  "threshold": 2,
  "maxLines": 5000,
  "minTokens": 50,
  "format": ["typescript", "tsx", "javascript"],
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "pnpm-lock.yaml"
  ],
  "absolute": true,
  "gitignore": true
}
